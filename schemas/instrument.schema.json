{
  "$defs": {
    "Channels": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "default": 1,
          "title": "Count",
          "type": "integer"
        },
        "overrides": {
          "additionalProperties": {
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "object"
          },
          "description": "Per-channel overrides of channel_state specs, e.g. {3: {frequency: {max: 2e8}}}",
          "title": "Overrides",
          "type": "object"
        }
      },
      "title": "Channels",
      "type": "object"
    },
    "CommandSpec": {
      "additionalProperties": false,
      "description": "One SCPI command: bound to a setting (``state``), to a component operation (``op``), or, through\nits parameters' ``state``, to several settings at once.",
      "properties": {
        "args": {
          "additionalProperties": true,
          "description": "Constant arguments passed to the operation",
          "title": "Args",
          "type": "object"
        },
        "dangerous": {
          "default": false,
          "title": "Dangerous",
          "type": "boolean"
        },
        "doc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc"
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Virtual time the command consumes (D12)",
          "title": "Duration"
        },
        "factor": {
          "default": 1.0,
          "description": "The command's number is the bound setting times factor: :TIMebase:RANGe is factor 10 on the time/div setting; a write divides by it",
          "title": "Factor",
          "type": "number"
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResponseFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the definition's response format"
        },
        "header": {
          "description": "Header pattern, e.g. '[:SOURce<ch>]:FREQuency[:CW]'",
          "title": "Header",
          "type": "string"
        },
        "op": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Component operation, e.g. 'acq.digitize'",
          "title": "Op"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/ParamSpec"
          },
          "title": "Params",
          "type": "array"
        },
        "query": {
          "default": true,
          "title": "Query",
          "type": "boolean"
        },
        "reply": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Query reply template: {header} (the echoed header, see dialect.echo_header; with echo off it and the space after it are left out), {value} (the bound setting, or an operation's reply) and {<setting>}, e.g. '{header} {value} V'. Default: '{header} {value}' for settings; an operation's reply as it is",
          "title": "Reply"
        },
        "set": {
          "default": true,
          "title": "Set",
          "type": "boolean"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "State path bound to the command, e.g. 'ch.frequency'",
          "title": "State"
        },
        "when": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use this command only when parameters have these values, e.g. {name: DATA_ARRAY_1}: several commands may share a header, told apart by a parameter (C1:INSPECT? \"WAVEDESC\")",
          "title": "When"
        }
      },
      "required": [
        "header"
      ],
      "title": "CommandSpec",
      "type": "object"
    },
    "ComponentSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "description": "Parameter values: a literal, a setting ('$ch.frequency') or a mapping of a setting ({from, map, scale, offset, default})",
          "title": "Params",
          "type": "object"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "ComponentSpec",
      "type": "object"
    },
    "DeviationSpec": {
      "additionalProperties": false,
      "description": "A definition's deviation: which component parameter, and its range.",
      "properties": {
        "by": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {},
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Draw one value per cell of a table, e.g. {function: [DC], range: [0.1, 1, 10]}: the parameter becomes the nested table {DC: {0.1: …, 1: …, 10: …}}",
          "title": "By"
        },
        "coverage": {
          "default": 2.0,
          "description": "normal: the coverage factor k of the limit (limit = k·σ)",
          "exclusiveMinimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "distribution": {
          "default": "uniform",
          "description": "uniform: anywhere within ±limit; normal: σ = limit / coverage, truncated at ±limit (a unit outside its specification is a fault, injected separately)",
          "enum": [
            "uniform",
            "normal"
          ],
          "title": "Distribution",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            }
          ],
          "description": "±limit. A number, or with `by` a table keyed by the values of the last `by` key (e.g. {0.1: 30, 1: 20} per range)",
          "title": "Limit"
        },
        "param": {
          "description": "'<component>.<parameter>', e.g. 'meter.gain_error_ppm'; a channel component's name (e.g. 'out.z_out') draws one value per channel",
          "pattern": "^[^.]+(\\.[^.]+)*\\.[^.]+$",
          "title": "Param",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "%",
                "ppm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'%' or 'ppm': relative to the nominal value, value = nominal × (1 + d). Omitted: the limit is in the parameter's own unit, value = nominal + d (a parameter that is itself an error, e.g. gain_error_ppm, or an offset)",
          "title": "Unit"
        }
      },
      "required": [
        "limit",
        "param"
      ],
      "title": "DeviationSpec",
      "type": "object"
    },
    "Dialect": {
      "additionalProperties": false,
      "description": "How replies are framed, for instruments that are not plain SCPI (e.g. LeCroy's ``C1:VDIV 200E-3 V``).\n\nThe defaults are SCPI: no header in replies, numbers without multiplier suffixes.",
      "properties": {
        "echo_header": {
          "default": "off",
          "description": "Replies start with the command header: off, short (C1:VDIV), long (C1:VOLT_DIV), or a setting whose value is OFF, SHORT or LONG ('$comm.header', switched by COMM_HEADER)",
          "pattern": "^(off|short|long|\\$.+)$",
          "title": "Echo Header",
          "type": "string"
        },
        "multipliers": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Suffixes of numbers written without a unit, e.g. {K: 1.0e3, M: 1.0e6} for 'MSIZ 10K'",
          "title": "Multipliers",
          "type": "object"
        }
      },
      "title": "Dialect",
      "type": "object"
    },
    "Display": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Front-panel buttons as the model's own commands, run inside the instrument (not over SCPI, D32), e.g. {single: ':TRIGger:MODE SINGle'}; run, stop and single default to the acquisition component's operations",
          "title": "Actions",
          "type": "object"
        },
        "channel_summary": {
          "items": {
            "type": "string"
          },
          "title": "Channel Summary",
          "type": "array"
        },
        "panel": {
          "anyOf": [
            {
              "$ref": "#/$defs/Panel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Front-panel layout: readings on the main display, grouped controls, softkeys (instrument-authoring.md 7.3)"
        },
        "summary": {
          "items": {
            "type": "string"
          },
          "title": "Summary",
          "type": "array"
        },
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UI class template, e.g. 'oscilloscope'",
          "title": "Template"
        }
      },
      "title": "Display",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "firmware": {
          "default": "1.0.0",
          "title": "Firmware",
          "type": "string"
        },
        "idn": {
          "default": "{manufacturer},{model},{serial},{firmware}",
          "title": "Idn",
          "type": "string"
        },
        "serial": {
          "default": "SB000001",
          "title": "Serial",
          "type": "string"
        }
      },
      "title": "Identity",
      "type": "object"
    },
    "Panel": {
      "additionalProperties": false,
      "description": "The instrument's front panel as the UI draws it (instrument-authoring.md 7.3): the main\ndisplay's readings, groups of controls, and softkeys. Without one, a multimeter and a calibrator\nget their class's default layout; the classes with a dedicated screen do not use it.",
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/PanelGroup"
          },
          "title": "Groups",
          "type": "array"
        },
        "readouts": {
          "items": {
            "$ref": "#/$defs/PanelReadout"
          },
          "title": "Readouts",
          "type": "array"
        },
        "softkeys": {
          "items": {
            "$ref": "#/$defs/PanelSoftkey"
          },
          "title": "Softkeys",
          "type": "array"
        }
      },
      "title": "Panel",
      "type": "object"
    },
    "PanelControl": {
      "additionalProperties": false,
      "description": "One setting on the panel, and the control it is set with (instrument-authoring.md 7.3).",
      "properties": {
        "control": {
          "description": "buttons: a key per value (an enum's options, or `keys`); number: a value with its unit and step keys; switch: on / off (bool); select: a drop-down (enum)",
          "enum": [
            "buttons",
            "number",
            "switch",
            "select"
          ],
          "title": "Control",
          "type": "string"
        },
        "keys": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PanelKey"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "buttons: the keys; default for an enum: one per option, for a bool: on and off",
          "title": "Keys"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default: the setting's label",
          "title": "Label"
        },
        "label_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label En"
        },
        "state": {
          "description": "The setting, e.g. 'sense.function' (a channel's: 'ch1.level')",
          "title": "State",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "number: what the step keys add and subtract",
          "title": "Step"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "number: the unit shown; default: the setting's",
          "title": "Unit"
        }
      },
      "required": [
        "state",
        "control"
      ],
      "title": "PanelControl",
      "type": "object"
    },
    "PanelGroup": {
      "additionalProperties": false,
      "properties": {
        "controls": {
          "items": {
            "$ref": "#/$defs/PanelControl"
          },
          "title": "Controls",
          "type": "array"
        },
        "label": {
          "description": "The group's title, e.g. 测量, 量程, 触发",
          "title": "Label",
          "type": "string"
        },
        "label_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label En"
        }
      },
      "required": [
        "label"
      ],
      "title": "PanelGroup",
      "type": "object"
    },
    "PanelKey": {
      "additionalProperties": false,
      "description": "One key of a button group: the value it writes, and what it reads on the instrument.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The key's text; default: the option's label or the value",
          "title": "Label"
        },
        "label_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label En"
        },
        "sets": {
          "additionalProperties": true,
          "description": "Further settings written along with it, e.g. {sense.range_auto: false} for a range key; the key is lit while all of them hold",
          "title": "Sets",
          "type": "object"
        },
        "value": {
          "description": "The value the key writes to the control's setting",
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "PanelKey",
      "type": "object"
    },
    "PanelReadout": {
      "additionalProperties": false,
      "description": "A reading on the main display.",
      "properties": {
        "digits": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Significant digits shown",
          "title": "Digits"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "label_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label En"
        },
        "reading": {
          "description": "A reading of the instrument, '<component>.<reading>', e.g. 'meter.DC'",
          "title": "Reading",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The reading's unit, e.g. V; none for a count or a word",
          "title": "Unit"
        },
        "when": {
          "additionalProperties": true,
          "description": "Shown only while these settings have these values, e.g. {sense.function: VOLT}",
          "title": "When",
          "type": "object"
        }
      },
      "required": [
        "reading"
      ],
      "title": "PanelReadout",
      "type": "object"
    },
    "PanelSoftkey": {
      "additionalProperties": false,
      "description": "A key under the display: a front-panel action (D32), or a setting written to a value.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "enum": [
                "run",
                "stop",
                "single"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A front-panel action, as `display.actions` names them",
          "title": "Action"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "label_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label En"
        },
        "sets": {
          "additionalProperties": true,
          "description": "Further settings written along with it",
          "title": "Sets",
          "type": "object"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The setting the key writes",
          "title": "State"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "label"
      ],
      "title": "PanelSoftkey",
      "type": "object"
    },
    "ParamSpec": {
      "additionalProperties": false,
      "description": "A parameter of an operation command.",
      "properties": {
        "combine": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "type quantities: what a combination of units writes besides, keyed by the units joined with commas in the `units` table's order ('V,HZ'); a value may be conditional, {if_zero: <state>, then: ..., else: ...}. A combination not listed is refused",
          "title": "Combine"
        },
        "combine_error": {
          "default": -224,
          "description": "Error code for a combination of units `combine` does not list",
          "title": "Combine Error",
          "type": "integer"
        },
        "default": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "type channel_list: the channels used when the optional parameter is omitted, e.g. [1] for an instrument whose (@1) may be left out",
          "title": "Default"
        },
        "duplicate_unit_error": {
          "default": -224,
          "description": "Error code for a unit given twice in one command",
          "title": "Duplicate Unit Error",
          "type": "integer"
        },
        "index": {
          "default": false,
          "description": "An int that picks which settings the other parameters write: their state paths name it in braces, e.g. 'measure.p{slot}.kind' (PACU 1,AMPL,C1); a query takes it too (PACU? 1)",
          "title": "Index",
          "type": "boolean"
        },
        "keys": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "type pairs: 'name,value,name,value...'; each name writes the setting it maps to, null accepts the name and ignores its value. All values are checked before any is set",
          "title": "Keys"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "missing_unit_error": {
          "default": -131,
          "description": "Error code for a value without a unit (the text comes from `errors`)",
          "title": "Missing Unit Error",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Setting this parameter writes (a command without `state` or `op`); it is parsed as that setting reads values",
          "title": "State"
        },
        "type": {
          "enum": [
            "float",
            "int",
            "bool",
            "enum",
            "string",
            "float_list",
            "block",
            "raw",
            "pairs",
            "quantities",
            "channel_list"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "units": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/QuantityUnit"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "type quantities: comma-separated 'value unit' parameters, each written into the setting its unit names, e.g. {V: {state: out.level}, HZ: {state: out.frequency}}; the multiplier moves into the value (mV, kHz)",
          "title": "Units"
        },
        "unknown_unit_error": {
          "default": -131,
          "description": "Error code for a unit the `units` table does not name",
          "title": "Unknown Unit Error",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "ParamSpec",
      "type": "object"
    },
    "Ports": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "'OUT{n}': 'out.pin'",
          "title": "Channel",
          "type": "object"
        },
        "instrument": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Instrument",
          "type": "object"
        },
        "media": {
          "additionalProperties": {
            "enum": [
              "signal",
              "electrical",
              "reference"
            ],
            "type": "string"
