{
  "$defs": {
    "Channels": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "default": 1,
          "title": "Count",
          "type": "integer"
        },
        "overrides": {
          "additionalProperties": {
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "object"
          },
          "description": "Per-channel overrides of channel_state specs, e.g. {3: {frequency: {max: 2e8}}}",
          "title": "Overrides",
          "type": "object"
        }
      },
      "title": "Channels",
      "type": "object"
    },
    "CommandSpec": {
      "additionalProperties": false,
      "description": "One SCPI command: bound to a setting (``state``), to a component operation (``op``), or, through\nits parameters' ``state``, to several settings at once.",
      "properties": {
        "args": {
          "additionalProperties": true,
          "description": "Constant arguments passed to the operation",
          "title": "Args",
          "type": "object"
        },
        "dangerous": {
          "default": false,
          "title": "Dangerous",
          "type": "boolean"
        },
        "doc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc"
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Virtual time the command consumes (D12)",
          "title": "Duration"
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResponseFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the definition's response format"
        },
        "header": {
          "description": "Header pattern, e.g. '[:SOURce<ch>]:FREQuency[:CW]'",
          "title": "Header",
          "type": "string"
        },
        "op": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Component operation, e.g. 'acq.digitize'",
          "title": "Op"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/ParamSpec"
          },
          "title": "Params",
          "type": "array"
        },
        "query": {
          "default": true,
          "title": "Query",
          "type": "boolean"
        },
        "reply": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Query reply template: {header} (the echoed header, see dialect.echo_header; with echo off it and the space after it are left out), {value} (the bound setting, or an operation's reply) and {<setting>}, e.g. '{header} {value} V'. Default: '{header} {value}' for settings; an operation's reply as it is",
          "title": "Reply"
        },
        "set": {
          "default": true,
          "title": "Set",
          "type": "boolean"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "State path bound to the command, e.g. 'ch.frequency'",
          "title": "State"
        },
        "when": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use this command only when parameters have these values, e.g. {name: DATA_ARRAY_1}: several commands may share a header, told apart by a parameter (C1:INSPECT? \"WAVEDESC\")",
          "title": "When"
        }
      },
      "required": [
        "header"
      ],
      "title": "CommandSpec",
      "type": "object"
    },
    "ComponentSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "description": "Parameter values: a literal, a setting ('$ch.frequency') or a mapping of a setting ({from, map, scale, offset, default})",
          "title": "Params",
          "type": "object"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "ComponentSpec",
      "type": "object"
    },
    "Dialect": {
      "additionalProperties": false,
      "description": "How replies are framed, for instruments that are not plain SCPI (e.g. LeCroy's ``C1:VDIV 200E-3 V``).\n\nThe defaults are SCPI: no header in replies, numbers without multiplier suffixes.",
      "properties": {
        "echo_header": {
          "default": "off",
          "description": "Replies start with the command header: off, short (C1:VDIV), long (C1:VOLT_DIV), or a setting whose value is OFF, SHORT or LONG ('$comm.header', switched by COMM_HEADER)",
          "pattern": "^(off|short|long|\\$.+)$",
          "title": "Echo Header",
          "type": "string"
        },
        "multipliers": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Suffixes of numbers written without a unit, e.g. {K: 1.0e3, M: 1.0e6} for 'MSIZ 10K'",
          "title": "Multipliers",
          "type": "object"
        }
      },
      "title": "Dialect",
      "type": "object"
    },
    "Display": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Front-panel buttons as the model's own commands, run inside the instrument (not over SCPI, D32), e.g. {single: ':TRIGger:MODE SINGle'}; run, stop and single default to the acquisition component's operations",
          "title": "Actions",
          "type": "object"
        },
        "channel_summary": {
          "items": {
            "type": "string"
          },
          "title": "Channel Summary",
          "type": "array"
        },
        "summary": {
          "items": {
            "type": "string"
          },
          "title": "Summary",
          "type": "array"
        },
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UI class template, e.g. 'oscilloscope'",
          "title": "Template"
        }
      },
      "title": "Display",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "firmware": {
          "default": "1.0.0",
          "title": "Firmware",
          "type": "string"
        },
        "idn": {
          "default": "{manufacturer},{model},{serial},{firmware}",
          "title": "Idn",
          "type": "string"
        },
        "serial": {
          "default": "SB000001",
          "title": "Serial",
          "type": "string"
        }
      },
      "title": "Identity",
      "type": "object"
    },
    "ParamSpec": {
      "additionalProperties": false,
      "description": "A parameter of an operation command.",
      "properties": {
        "index": {
          "default": false,
          "description": "An int that picks which settings the other parameters write: their state paths name it in braces, e.g. 'measure.p{slot}.kind' (PACU 1,AMPL,C1); a query takes it too (PACU? 1)",
          "title": "Index",
          "type": "boolean"
        },
        "keys": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "type pairs: 'name,value,name,value...'; each name writes the setting it maps to, null accepts the name and ignores its value. All values are checked before any is set",
          "title": "Keys"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Setting this parameter writes (a command without `state` or `op`); it is parsed as that setting reads values",
          "title": "State"
        },
        "type": {
          "enum": [
            "float",
            "int",
            "bool",
            "enum",
            "string",
            "float_list",
            "block",
            "raw",
            "pairs"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "ParamSpec",
      "type": "object"
    },
    "Ports": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "'OUT{n}': 'out.pin'",
          "title": "Channel",
          "type": "object"
        },
        "instrument": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Instrument",
          "type": "object"
        },
        "media": {
          "additionalProperties": {
            "enum": [
              "signal",
              "electrical",
              "reference"
            ],
            "type": "string"
          },
          "description": "What an exposed port carries when it is not plain electrical, e.g. {REF_IN: reference} for a timebase or lock-in reference; the canvas draws such wires as reference wires",
          "title": "Media",
          "type": "object"
        }
      },
      "title": "Ports",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "description": "The manual a real-model definition follows (D42): behavior is checked against this edition.",
      "properties": {
        "document": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Document or part number",
          "title": "Document"
        },
        "firmware": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Firmware version the manual describes",
          "title": "Firmware"
        },
        "title": {
          "description": "e.g. 'Keysight Truevolt Series Operating and Service Guide'",
          "title": "Title",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Edition, revision or date",
          "title": "Version"
        }
      },
      "required": [
        "title"
      ],
      "title": "Reference",
      "type": "object"
    },
    "ResponseFormat": {
      "additionalProperties": false,
      "description": "How query responses are written (real models, D42): numbers, booleans and enumerations.\n\nThe defaults are what ``sb-*`` instruments have always returned, e.g. ``+1.000000E+03``.",
      "properties": {
        "boolean": {
          "default": "numeric",
          "description": "numeric: 1/0; word: ON/OFF",
          "enum": [
            "numeric",
            "word"
          ],
          "title": "Boolean",
          "type": "string"
        },
        "digits": {
          "default": 6,
          "description": "Digits after the decimal point (nr3 mantissa, nr2)",
          "maximum": 17,
          "minimum": 0,
          "title": "Digits",
          "type": "integer"
        },
        "enum": {
          "default": "short",
          "description": "short: SIN; long: SINUSOID (upper case); as_defined: SINusoid, as in `options`",
          "enum": [
            "short",
            "long",
            "as_defined"
          ],
          "title": "Enum",
          "type": "string"
        },
        "error_code": {
          "default": "plain",
          "description": "Code in :SYSTem:ERRor? replies: plain: 0,\"No error\"; signed: +0,\"No error\"",
          "enum": [
            "plain",
            "signed"
          ],
          "title": "Error Code",
          "type": "string"
        },
        "exponent_digits": {
          "default": 2,
          "description": "nr3: digits of the exponent, e.g. E+03 is 2",
          "maximum": 3,
          "minimum": 1,
          "title": "Exponent Digits",
          "type": "integer"
        },
        "integer": {
          "default": "plain",
          "description": "plain: 5; signed: +5; engineering: 100E+3",
          "enum": [
            "plain",
            "signed",
            "engineering"
          ],
          "title": "Integer",
          "type": "string"
        },
        "number": {
          "default": "nr3",
          "description": "nr3: +1.000000E+03; nr2: +1000.000000; nr1: +1000 (rounded); engineering: 1E+3, 200E-3 (exponent a multiple of 3, shortest mantissa)",
          "enum": [
            "nr3",
            "nr2",
            "nr1",
            "engineering"
          ],
          "title": "Number",
          "type": "string"
        },
        "sign": {
          "default": true,
          "description": "Write '+' before non-negative numbers",
          "title": "Sign",
          "type": "boolean"
        }
      },
      "title": "ResponseFormat",
      "type": "object"
    },
    "StateSpec": {
      "additionalProperties": false,
      "description": "One settable state variable.",
      "properties": {
        "default": {
          "default": null,
          "title": "Default"
        },
        "display_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit shown in the UI when it differs from `unit`, e.g. '×'",
          "title": "Display Unit"
        },
        "electrical": {
          "default": false,
          "description": "Changing this variable changes the bench's circuit",
          "title": "Electrical",
          "type": "boolean"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "label_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label En"
        },
        "ladder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Snap writes to a ladder: '1-2-5', '1-3' or an explicit list of values",
          "title": "Ladder"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "option_labels": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the UI shows enum options, e.g. {ONEMeg: '1 MΩ', FIFTy: '50 Ω'}",
          "title": "Option Labels"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Enum options in SCPI mixed case, e.g. SINusoid",
          "title": "Options"
        },
        "ratio": {
          "default": false,
          "description": "A ratio (0.25 for 25 %) that also accepts a percentage: a written value above 1 is divided by 100 (40 -> 0.4)",
          "title": "Ratio",
          "type": "boolean"
        },
        "readonly": {
          "default": false,
          "title": "Readonly",
          "type": "boolean"
        },
        "rst": {
          "default": null,
          "description": "Value after *RST; defaults to `default`",
          "title": "Rst"
        },
        "special": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extra keywords accepted for numbers, e.g. {INF: .inf} for a high-Z load",
          "title": "Special"
        },
        "type": {
          "enum": [
            "float",
            "int",
            "bool",
            "enum",
            "string"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Base SCPI unit for suffix parsing, e.g. HZ, V, S, OHM",
          "title": "Unit"
        }
      },
      "required": [
        "type"
      ],
      "title": "StateSpec",
      "type": "object"
    },
    "Wiring": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "description": "Signal wires inside each channel",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Channel",
          "type": "array"
        },
        "instrument": {
          "description": "Signal wires at instrument level; '{n}' expands per channel",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Instrument",
          "type": "array"
        }
      },
      "title": "Wiring",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "builtins": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Built-in headers this model answers (e.g. ['*IDN', '*OPC', '*RST']); the others are not modeled. Default: all of them",
      "title": "Builtins"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "channel_components": {
      "items": {
        "$ref": "#/$defs/ComponentSpec"
      },
      "title": "Channel Components",
      "type": "array"
    },
    "channel_state": {
      "additionalProperties": {
        "$ref": "#/$defs/StateSpec"
      },
      "title": "Channel State",
      "type": "object"
    },
    "channels": {
      "$ref": "#/$defs/Channels"
    },
    "class": {
      "title": "Class",
      "type": "string"
    },
    "commands": {
      "items": {
        "$ref": "#/$defs/CommandSpec"
      },
      "title": "Commands",
      "type": "array"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/ComponentSpec"
      },
      "title": "Components",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "dialect": {
      "$ref": "#/$defs/Dialect",
      "description": "Reply framing beyond SCPI (headers, suffixes)"
    },
    "display": {
      "$ref": "#/$defs/Display"
    },
    "error_queue": {
      "anyOf": [
        {
          "minimum": 2,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Error queue length; on overflow the last entry becomes -350 (SCPI-99 21.8)",
      "title": "Error Queue"
    },
    "errors": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Error texts by code: overrides standard texts and adds device-specific codes",
      "title": "Errors",
      "type": "object"
    },
    "format": {
      "$ref": "#/$defs/ResponseFormat",
      "description": "Default response format"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/Identity"
    },
    "manufacturer": {
      "title": "Manufacturer",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "ports": {
      "$ref": "#/$defs/Ports"
    },
    "reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reference"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The manual this definition follows; a definition with a reference is a real model: unknown commands answer -113 'not modeled by SimuBench', error texts follow `errors`"
    },
    "schema": {
      "const": "simubench.instrument/1",
      "default": "simubench.instrument/1",
      "title": "Schema",
      "type": "string"
    },
    "specs": {
      "additionalProperties": true,
      "description": "Accuracy and other specifications from the manual; stored, not yet used in calculations",
      "title": "Specs",
      "type": "object"
    },
    "state": {
      "additionalProperties": {
        "$ref": "#/$defs/StateSpec"
      },
      "title": "State",
      "type": "object"
    },
    "unknown_commands": {
      "default": "error",
      "description": "A header the definition does not have: 'error' queues -113; 'ignore' swallows it (no error, no reply) and logs an 'ignored' event. Only for definitions without `reference` (D42)",
      "enum": [
        "error",
        "ignore"
      ],
      "title": "Unknown Commands",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
