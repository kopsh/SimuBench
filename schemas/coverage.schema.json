          "title": "Header",
          "type": "string"
        },
        "level": {
          "enum": [
            "implemented",
            "accepted",
            "not_modeled"
          ],
          "title": "Level",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "header",
        "level"
      ],
      "title": "CoverageEntry",
      "type": "object"
    },
    "CoverageSection": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "items": {
            "$ref": "#/$defs/CoverageEntry"
          },
          "title": "Commands",
          "type": "array"
        },
        "section": {
          "description": "Manual section, e.g. 'Command Reference > SENSe Subsystem'",
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "section",
        "commands"
      ],
      "title": "CoverageSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
