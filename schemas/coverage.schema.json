      "title": "Model",
      "type": "string"
    },
    "schema": {
      "const": "simubench.coverage/1",
      "default": "simubench.coverage/1",
      "title": "Schema",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/CoverageSection"
      },
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "model",
    "sections"
  ],
  "title": "Coverage",
  "type": "object"
