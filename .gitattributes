# Generated files are compared byte for byte in CI (D21); keep LF on every platform.
* text=auto eol=lf
*.png binary
*.woff binary
*.woff2 binary

# Vendor manuals (manuals/): the PDFs in Git LFS, their text versions as ordinary text.
manuals/**/*.pdf filter=lfs diff=lfs merge=lfs -text

# A GitHub zip or `git archive` fills in the commit and tag, so the version is known without .git (D58).
.git_archival.txt export-subst
